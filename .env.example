# Copy to .env. Keep actual keys out of Git and chat.
# Live collection stays disabled unless credentials, product scope and permission reference are provided.
TAOBAO_PERMITTED=false
TAOBAO_PERMISSION_REF=
TAOBAO_EXPIRES_AT=
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_SESSION=
TAOBAO_PRODUCT_IDS=
TAOBAO_INTERVAL_SECONDS=3600
TAOBAO_MIN_GAP_SECONDS=5
TAOBAO_DAILY_BUDGET=100
TAOBAO_MAX_AGE_SECONDS=7200
TAOBAO_AI_ALLOWED=false

# A locally configured authorized service conforming to docs/provider-contract.md.
# This project does not include or endorse any data vendor.
PROVIDER_PERMITTED=false
PROVIDER_PERMISSION_REF=
PROVIDER_EXPIRES_AT=
PROVIDER_BASE_URL=
PROVIDER_TOKEN=
PROVIDER_PRODUCT_IDS=
PROVIDER_INTERVAL_SECONDS=3600
PROVIDER_MIN_GAP_SECONDS=5
PROVIDER_DAILY_BUDGET=100
PROVIDER_MAX_AGE_SECONDS=7200
PROVIDER_AI_ALLOWED=false

# DeepSeek official API preset, verified 2026-10-21.
# deepseek-flash currently serves DeepSeek-V4.1-Flash-1017.
# https://api-docs.deepseek.com/
# Replay is allowed to use constructed samples; live content also requires SOURCE_AI_ALLOWED=true.
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_DAILY_BUDGET=20

# Optional absolute path; default is this repository's data/monitor.sqlite3.
# DATABASE_PATH=
